	"styles": {
		"blocks": {
			"core/quote": {
				"variations": {
					"plain": {
						"typography": {
							"fontFamily": "var(--wp--preset--font-family--font-main)",
							"fontSize": "var(--wp--preset--font-size--heading-2)",
							"lineHeight": "var(--wp--custom--line-height--headings)",
							"fontStyle": "italic"
						},
						"spacing": {
							"margin": {
								"left": "0",
								"right": "0",
								"top": "var(--wp--custom--layout--gap)",
								"bottom": "var(--wp--custom--layout--gap)"
							},
							"padding": {
								"left": "0"
							}
						}
					}
				}
			},
			"core/media-text": {
				"spacing": {
					"blockGap": "var(--wp--custom--layout--gap-large)"
				}
			},
			"core/buttons": {
				"spacing": {
					"blockGap": "var(--wp--preset--spacing--10)"
				}
			},
			"core/group": {
				"spacing": {
					"blockGap": "var(--wp--preset--spacing--10)"
				}
			},
			"core/paragraph": {
				"spacing": {
					"margin": {
						"top": "0",
						"bottom": "var(--wp--preset--spacing--10)"
					}
				}
			},
			"core/cover": {
				"spacing": {
					"padding": {
						"top": "var(--wp--custom--layout--gap)",
						"bottom": "var(--wp--custom--layout--gap)",
						"left": "var(--wp--custom--layout--gap)",
						"right": "var(--wp--custom--layout--gap)"
					}
				}
			},
			"core/navigation-link": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--body)"
				}
			},
			"core/post-excerpt": {
				"css": "& .wp-block-post-excerpt__more-link { display: inline-block; border-width: 1px; border-style: solid; border-radius: var(--wp--custom--border-radius--rounded); background-color: var(--wp--preset--color--primary); border-color: var(--wp--preset--color--primary); color: var(--wp--preset--color--text); padding: var(--wp--preset--spacing--05) var(--wp--preset--spacing--20); font-family: var(--wp--preset--font-family--font-main); font-size: var(--wp--preset--font-size--body); font-weight: bold; line-height: var(--wp--custom--line-height--normal); text-decoration: none; }"
			}
		},
		"color": {
			"background": "var(--wp--preset--color--neutral-10)",
			"text": "var(--wp--preset--color--foreground)"
		},
		"elements": {
			"button": {
				"border": {
					"radius": "var(--wp--custom--border-radius--rounded)",
					"width": "1px"
				},
